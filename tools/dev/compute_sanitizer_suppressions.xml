<?xml version="1.0" encoding="utf-8"?>
<ComputeSanitizerOutput>
  <!-- Fields are regexes, but compute-sanitizer 2026.4 matches nothing whose regex has a backslash escape:
       [.] stands for a literal dot -->
  <!-- NCCL asks for driver entry points of a newer CUDA than the driver's, then falls back (in initOnceFunc, called
       from NCCL itself or, on a communicator's first init, from libc's pthread_once) -->
  <record>
    <kind>Api</kind>
    <what>
      <api>cudaGetDriverEntryPointByVersion|cudaGetLastError</api>
      <error>cudaErrorInvalidValue</error>
    </what>
    <hostStack>
      <frame>
        <module>.*lib(cuda|nccl)[.]so.*</module>
      </frame>
      <frame>
        <module>.*lib(nccl|c)[.]so.*</module>
      </frame>
    </hostStack>
  </record>
  <!-- Open MPI's CUDA accelerator component unregisters host memory it never registered at MPI_Finalize -->
  <record>
    <kind>Api</kind>
    <what>
      <api>cuMemHostUnregister</api>
      <error>CUDA_ERROR_HOST_MEMORY_NOT_REGISTERED</error>
    </what>
    <hostStack>
      <frame>
        <module>.*(libcuda|mca_accelerator_cuda)[.]so.*</module>
      </frame>
      <frame>
        <module>.*(mca_accelerator_cuda|libopen-pal)[.]so.*</module>
      </frame>
    </hostStack>
  </record>
  <!-- NCCL looks up its kernels for every architecture it was built for; those of other architectures fail -->
  <record>
    <kind>Api</kind>
    <what>
      <api>cudaFuncGetAttributes|cudaGetLastError</api>
      <error>cudaErrorNoKernelImageForDevice</error>
    </what>
    <hostStack>
      <frame>
        <module>.*lib(cuda|nccl)[.]so.*</module>
      </frame>
      <frame>
        <module>.*libnccl[.]so.*</module>
      </frame>
    </hostStack>
  </record>
  <!-- Open MPI's CUDA accelerator component asks whether a pointer is a VMM or memory-pool allocation; for other
       device memory the driver answers CUDA_ERROR_INVALID_VALUE -->
  <record>
    <kind>Api</kind>
    <what>
      <api>cuMemRetainAllocationHandle|cuMemPoolGetAccess</api>
      <error>CUDA_ERROR_INVALID_VALUE</error>
    </what>
    <hostStack>
      <frame>
        <module>.*(libcuda|mca_accelerator_cuda)[.]so.*</module>
      </frame>
      <frame>
        <module>.*(mca_accelerator_cuda|libopen-pal)[.]so.*</module>
      </frame>
    </hostStack>
  </record>
</ComputeSanitizerOutput>
