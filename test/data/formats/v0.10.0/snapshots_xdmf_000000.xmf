<!-- mallard-run {"schema":"mallard-run","version":3,"mallard":{"version":"v0.10.0","git_sha":null,"git_dirty":null},"build":{"dim":2,"precision":"double","build_type":"Release","compiler":"AppleClang 21.0.0.21000334","cxx_flags":"-O3 -DNDEBUG","kokkos":"5.2.2","backend":"Threads","host_backend":"Threads","mpi":false,"gpu_aware_mpi":false,"nccl":false,"hdf5":true,"hdf5_parallel":false,"kaminpar":false,"species_layout":"right"},"dependencies":{"compiler":"AppleClang 21.0.0.21000334","kokkos":"5.2.2","mpi":null,"hdf5":"2.2.0","cgns":null,"zlib":null,"nccl":null,"gpu_runtime":null,"gpu_driver":null},"run":{"run_id":"e177d27b-1343-4d62-8dfe-6b0e9c391500","start_time":"2026-11-13T13:40:24Z","ranks":1,"host":"fixture-host","device":"Apple M4 Pro","directory":"/fixtures/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","hosts":1,"restart_of":null},"input":{"file":"snapshots.toml","sha256":"816e013e7e7f3af5784122a7ae53df5c26a9eb487dffdf94c03cfd3641ef21b8","text":"# Format fixture: snapshots in every format, probes, forces and integrals of\n# the perfect gas of gas.toml, one step. See README.md.\n[run]\nn_steps = 1\ncfl = 0.2\n\n[mesh]\ntype = \"cartesian\"\nNx = 6\nNy = 5\nLx = 1.0\nLy = 1.0\n\n[initialize]\ntype = \"analytical\"\nrho = \"1.0 + 0.3 * x + 0.2 * y * y\"\nu = [\"0.1 + 0.2 * y\", \"-0.1 * x\"]\np = \"1.0 + 0.1 * x * y\"\n\n[[boundaries]]\nname = \"left\"\ntype = \"outlet_extrapolation\"\n\n[[boundaries]]\nname = \"right\"\ntype = \"outlet_extrapolation\"\n\n[[boundaries]]\nname = \"top\"\ntype = \"symmetry\"\n\n[[boundaries]]\nname = \"bottom\"\ntype = \"wall_adiabatic\"\n\n[numerics]\nriemann_solver = \"HLLC\"\ntime_integrator = \"SSPRK3\"\n\n[numerics.face_reconstruction]\ntype = \"MUSCL\"\n\n[physics]\ntype = \"euler\"\ngamma = 1.4\np_ref = 1.0\nT_ref = 1.0\nrho_ref = 1.0\n\n[output]\ncheck_interval = 1000\nrun_log = \"snapshots.jsonl\"\n\n[[write_data]]\nprefix = \"snapshots_vtkhdf\"\nformat = \"vtkhdf\"\nseries = false\nfields = [\"RHO\", \"U\", \"P\"]\ninterval = 1\n\n[[write_data]]\nprefix = \"snapshots_series\"\nformat = \"vtkhdf\"\nseries = true\nfields = [\"RHO\", \"U\", \"P\"]\ninterval = 1\n\n[[write_data]]\nprefix = \"snapshots_vtu\"\nformat = \"vtu\"\nfields = [\"RHO\", \"U\", \"P\"]\ninterval = 1\n\n[[write_data]]\nprefix = \"snapshots_xdmf\"\nformat = \"xdmf\"\nfields = [\"RHO\", \"U\", \"P\"]\ninterval = 1\n\n[[write_data]]\nprefix = \"snapshots\"\nformat = \"restart\"\ninterval = 1\n\n[[probes]]\nname = \"line\"\ntype = \"line\"\nstart = [0.1, 0.5]\nend = [0.9, 0.5]\nn_points = 3\nfields = [\"RHO\", \"P\"]\nfile = \"snapshots_probe.csv\"\n\n[[probes]]\nname = \"line_h5\"\ntype = \"line\"\nstart = [0.1, 0.5]\nend = [0.9, 0.5]\nn_points = 3\nfields = [\"RHO\", \"P\"]\nformat = \"hdf5\"\nfile = \"snapshots_probe.h5\"\n\n[[forces]]\nzone = \"bottom\"\nfile = \"snapshots_forces.csv\"\n\n[integrals]\nfile = \"snapshots_integrals.csv\"\n","resolved":"[[boundaries]]\nname = \"left\"\ntype = \"outlet_extrapolation\"\n\n[[boundaries]]\nname = \"right\"\ntype = \"outlet_extrapolation\"\n\n[[boundaries]]\nname = \"top\"\ntype = \"symmetry\"\n\n[[boundaries]]\nname = \"bottom\"\ntype = \"wall_adiabatic\"\n\n[[forces]]\nfile = \"snapshots_forces.csv\"\ninterval = 1\nzone = \"bottom\"\n\n[initialize]\nn_subdivisions = 4\np = \"1.0 + 0.1 * x * y\"\nrho = \"1.0 + 0.3 * x + 0.2 * y * y\"\ntype = \"analytical\"\nu = [\"0.1 + 0.2 * y\", \"-0.1 * x\"]\n\n[integrals]\nbudget = false\nfile = \"snapshots_integrals.csv\"\ninterval = 1\n\n[mesh]\nLx = 1.0\nLy = 1.0\nNx = 6\nNy = 5\ncell_order = \"auto\"\ncurved_geometry = true\ntype = \"cartesian\"\n\n[numerics]\ncheck_nan = false\nconvective_flux = \"riemann\"\ndouble_flux = false\nlow_mach_cutoff = 0.1\nriemann_solver = \"HLLC\"\ntime_integrator = \"SSPRK3\"\n\n[numerics.face_reconstruction]\nlimiter = \"venkatakrishnan\"\ntype = \"MUSCL\"\nvenkatakrishnan_K = 5.0\n\n[output]\nasync = true\ncheck_interval = 1000\ndivergence_report = \"divergence_report\"\nhealth = true\nio_threads = 1\nreport = \"report.html\"\nrun_log = \"snapshots.jsonl\"\nwrite_stencils = \"\"\n\n[physics]\nT_ref = 1.0\naxisymmetric = false\ngamma = 1.4\ngas = \"perfect\"\np_ref = 1.0\nrho_ref = 1.0\ntype = \"euler\"\nunits = \"SI\"\n\n[[probes]]\naverage = false\ncopies = \"combined\"\nend = [0.9, 0.5]\nfields = [\"RHO\", \"P\"]\nfile = \"snapshots_probe.csv\"\nformat = \"csv\"\ninterval = 1\nn_points = 3\nname = \"line\"\nreductions = []\nreductions_file = \"probe_line_reductions.csv\"\nsamples = true\nsampling = \"cell\"\nstart = [0.1, 0.5]\ntype = \"line\"\n\n[[probes]]\naverage = false\ncopies = \"combined\"\nend = [0.9, 0.5]\nfields = [\"RHO\", \"P\"]\nfile = \"snapshots_probe.h5\"\nformat = \"hdf5\"\ninterval = 1\nn_points = 3\nname = \"line_h5\"\nreductions = []\nreductions_file = \"probe_line_h5_reductions.csv\"\nsamples = true\nsampling = \"cell\"\nstart = [0.1, 0.5]\ntype = \"line\"\n\n[run]\ncfl = 0.2\ncontrol_file_interval = 0\ncontrol_socket = true\ncuda_graphs = true\nkeep_last_good = true\nn_steps = 1\nstep_queue = 3\nt_stop = -1.0\nt_wall_stop = -1.0\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U\", \"P\"]\nformat = \"vtkhdf\"\ninterval = 1\nprefix = \"snapshots_vtkhdf\"\nseries = false\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U\", \"P\"]\nformat = \"vtkhdf\"\ninterval = 1\nprefix = \"snapshots_series\"\nseries = true\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U\", \"P\"]\nformat = \"vtu\"\ninterval = 1\nprefix = \"snapshots_vtu\"\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U\", \"P\"]\nformat = \"xdmf\"\ninterval = 1\nprefix = \"snapshots_xdmf\"\n\n[[write_data]]\ncompression = \"none\"\nformat = \"restart\"\ninterval = 1\nprefix = \"snapshots\"\n"},"mesh":{"type":"cartesian"},"preset":null} -->
