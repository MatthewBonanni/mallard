{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matthewbonanni.github.io/mallard/schemas/mallard-session.v1.schema.json",
  "title": "Any message mallard session writes (JSON-RPC 2.0, one per line); initialize's result is mallard-capabilities",
  "$ref": "#/$defs/message",
  "$defs": {
    "id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "result": true
      }
    },
    "error": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    },
    "notification": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "enum": [
            "$/progress",
            "$/log"
          ]
        },
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "integer",
                "string"
              ]
            },
            "phase": {
              "type": "string"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "mallard-diagnostic.v1.schema.json"
              }
            }
          }
        }
      }
    },
    "message": {
      "oneOf": [
        {
          "$ref": "#/$defs/response"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/notification"
        }
      ]
    }
  }
}
